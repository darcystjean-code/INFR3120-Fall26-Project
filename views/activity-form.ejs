<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post an Activity</title>
</head>
<body>
    <%- include('partials/header.ejs') %>
    <h1>Post an Activity</h1>
    <form action="/activities" method="post">
        <div class="form-group">
        <p>
            <label for="title">Title</label>
            <input type="text" class="form-control" id="title" name="title" required>
        </p>
        <p>
            <label for="description">Description</label>
            <textarea id="description" class="form-control" name="description" required></textarea>
        </p>
        <p>
            <label for="date">Date</label>
            <input type="date" class="form-control" id="date" name="date" required>
        </p>
        <p>
            <label for="location">Location</label>
            <input type="text" class="form-control" id="location" name="location" required>
    
        </p>
        <p>
            <label for="duration">Duration in minutes</label>
            <input type="number" class="form-control" id="duration" name="duration" min="1" required>
        </p>
        <p> 
            <label for="startTime">Start Time</label>
            <input type="time" class="form-control" id="startTime" name="startTime" required>
        </p>
        <p>
            <label for="setting">Indoor or Outdoor</label>
            <select id="setting" name="setting" required>
                <option value="">Choose one</option>
                <option value="indoor">Indoor</option>
                <option value="outdoor">Outdoor</option>
            </select>
        </p>
        <button type="submit" class="btn btn-primary">Post Activity</button>
        </div>
    </form>
    <a href="/" class="btn btn-primary">Back To The Activity Board</a>
</body>
<div class="fixed-bottom">
    <!--Calls the footer partial-->
    <%- include('partials/footer.ejs') %>
</div>
</html>